# Cardano Network Configuration
# Options: preview, preprod, mainnet
NEXT_PUBLIC_CARDANO_NETWORK=preview

# Blockfrost API (required for blockchain interaction)
# Get your API key from https://blockfrost.io/
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=your_blockfrost_project_id_here

# LiteCert Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional: Database connection (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/litecert

# Optional: IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_GATEWAY=https://ipfs.io/ipfs/
