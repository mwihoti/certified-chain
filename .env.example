# Public app config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Cardano
# Supported values: preview, preprod, mainnet
NEXT_PUBLIC_CARDANO_NETWORK=preview
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=your_blockfrost_project_id
NEXT_PUBLIC_BLOCKFROST_API_KEY=your_blockfrost_api_key

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server-only integrations
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key
# Preferred for scoped Pinata keys
PINATA_JWT=your_pinata_jwt

# Cardano contract deployment
NEXT_PUBLIC_CONTRACT_COMPILED_CODE=
NEXT_PUBLIC_CONTRACT_ADDRESS_PREVIEW=
NEXT_PUBLIC_CONTRACT_ADDRESS_PREPROD=
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=

# Midnight privacy layer
NEXT_PUBLIC_MIDNIGHT_NETWORK=devnet
NEXT_PUBLIC_MIDNIGHT_NODE_URL=http://localhost:9944
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
# Server-only: deployer wallet mnemonic for anchoring certificates on Midnight
MIDNIGHT_DEPLOYER_MNEMONIC=
