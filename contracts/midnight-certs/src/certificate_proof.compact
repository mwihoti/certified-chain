pragma language_version >= 0.14.0;

// ============================================================
// LiteCert Certificate Proof Contract (Midnight Network)
//
// Privacy model:
//   PUBLIC  — certificate ID hash, institution key, validity flag
//   PRIVATE — recipient name, credential type, issue date (witness)
//
// Verifiers get a ZK proof that a statement is true ("this cert
// is valid", "holder has a coaching license") without seeing any
// personal data. The holder controls what they disclose.
// ============================================================

import CompactStandardLibrary;

// Public on-chain state — only hashes, never raw personal data
export ledger CertificateRegistry {
  certificates: Map<Bytes<32>, CertRecord>;
}

// Permanent on-chain record per certificate
struct CertRecord {
  // Hashed institution public key (Blake2b-256 of the verifying key)
  institution_key_hash: Bytes<32>;
  // SHA-256 of: name + credential_type + issue_date + institution_id
  cert_data_hash: Bytes<32>;
  // Unix timestamp (seconds) when issued
  issued_at: Uint<64>;
  // Validity flag — set to false on revocation
  is_valid: Boolean;
}

// Private witness — lives only on the holder's device, never sent to chain
witness CertificateWitness {
  recipient_name: Bytes<64>;
  credential_type: Bytes<64>;
  issue_date: Bytes<16>;
  institution_id: Bytes<32>;
}

// ============================================================
// CIRCUIT: issue_certificate
// Called by the institution when issuing a certificate.
// Records cert_data_hash on-chain. No personal data stored.
// ============================================================
export circuit issue_certificate(
  cert_id: Bytes<32>,
  cert_data_hash: Bytes<32>,
  institution_key_hash: Bytes<32>,
): [] {
  CertificateRegistry.certificates.insert(
    cert_id,
    CertRecord {
      institution_key_hash,
      cert_data_hash,
      issued_at: current_time(),
      is_valid: true,
    }
  );
}

// ============================================================
// CIRCUIT: prove_validity
// Proves a certificate is valid WITHOUT revealing any personal data.
// The ZK proof guarantees: "I hold a valid credential that matches
// the on-chain hash, issued by this institution."
// ============================================================
export circuit prove_validity(
  cert_id: Bytes<32>,
  private witness w: CertificateWitness,
): Boolean {
  const record = CertificateRegistry.certificates.lookup(cert_id);

  // Recompute hash from private witness — matches only if data is correct
  const computed_hash = persistent_hash<"LiteCert">(
    pad(64, w.recipient_name),
    pad(64, w.credential_type),
    pad(16, w.issue_date),
    pad(32, w.institution_id)
  );

  return record.is_valid && (computed_hash == record.cert_data_hash);
}

// ============================================================
// CIRCUIT: prove_credential_type
// Selective disclosure: proves the holder has a SPECIFIC credential
// (e.g. "CAF A Coaching License") without revealing their name.
// Use case: employer checks "does this person have a valid coaching
// license?" — gets a yes/no proof, not a name.
// ============================================================
export circuit prove_credential_type(
  cert_id: Bytes<32>,
  required_credential_type: Bytes<64>,
  private witness w: CertificateWitness,
): Boolean {
  const record = CertificateRegistry.certificates.lookup(cert_id);

  const computed_hash = persistent_hash<"LiteCert">(
    pad(64, w.recipient_name),
    pad(64, w.credential_type),
    pad(16, w.issue_date),
    pad(32, w.institution_id)
  );

  return record.is_valid
    && (computed_hash == record.cert_data_hash)
    && (w.credential_type == required_credential_type);
}

// ============================================================
// CIRCUIT: prove_not_expired
// Proves the certificate was issued before a given date AND
// that it has not been revoked — without revealing the issue date.
// ============================================================
export circuit prove_not_expired(
  cert_id: Bytes<32>,
  expiry_timestamp: Uint<64>,
  private witness w: CertificateWitness,
): Boolean {
  const record = CertificateRegistry.certificates.lookup(cert_id);

  const computed_hash = persistent_hash<"LiteCert">(
    pad(64, w.recipient_name),
    pad(64, w.credential_type),
    pad(16, w.issue_date),
    pad(32, w.institution_id)
  );

  return record.is_valid
    && (computed_hash == record.cert_data_hash)
    && (record.issued_at < expiry_timestamp);
}

// ============================================================
// CIRCUIT: revoke_certificate
// Institution revokes a certificate on Midnight.
// Requires proof of institution key to prevent unauthorized revocation.
// ============================================================
export circuit revoke_certificate(
  cert_id: Bytes<32>,
  institution_key_hash: Bytes<32>,
): [] {
  const record = CertificateRegistry.certificates.lookup(cert_id);

  // Only the original issuing institution can revoke
  assert record.institution_key_hash == institution_key_hash,
    "Unauthorized: only the issuing institution can revoke";

  CertificateRegistry.certificates.insert(
    cert_id,
    CertRecord {
      ..record,
      is_valid: false,
    }
  );
}
